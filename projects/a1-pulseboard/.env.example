# ---- A1 PulseBoard backend environment ----
# Copy to backend/.env and adjust. Never commit the real .env.

PORT=4005
PUBLIC_BASE_URL=http://localhost:4005

# PostgreSQL (Prisma reads DATABASE_URL). Port 5437 via the dev docker-compose.yml.
DATABASE_URL=postgresql://pulseboard:pulseboard@localhost:5437/pulseboard?schema=public

# Redis — the live sliding-window aggregates (genuinely required; fail-open to Postgres).
REDIS_URL=redis://localhost:6384

CORS_ORIGIN=http://localhost:5178

# Real-time engine
START_STREAM=true
WINDOW_MS=60000
SNAPSHOT_MS=1000
ROLLUP_MS=60000
SIMULATOR_RATE=5

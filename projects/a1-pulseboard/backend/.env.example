PORT=4005
PUBLIC_BASE_URL=http://localhost:4005
DATABASE_URL=postgresql://pulseboard:pulseboard@localhost:5437/pulseboard?schema=public
REDIS_URL=redis://localhost:6384
CORS_ORIGIN=http://localhost:5178

# Real-time engine
START_STREAM=true        # run the SSE broadcaster + rollup job in-process (false in tests)
WINDOW_MS=60000          # sliding aggregation window
SNAPSHOT_MS=1000         # how often the broadcaster pushes a snapshot
ROLLUP_MS=60000          # how often events are rolled into per-minute buckets
SIMULATOR_RATE=5         # synthetic events per second when the simulator is on

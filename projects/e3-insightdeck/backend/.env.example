PORT=4004
PUBLIC_BASE_URL=http://localhost:4004
DATABASE_URL=postgresql://insightdeck:insightdeck@localhost:5436/insightdeck?schema=public
REDIS_URL=redis://localhost:6383
CORS_ORIGIN=http://localhost:5177

# Narration backend. llm is a stub (no keys in this air-gapped build): the Narrator
# interface exists so a real model drops in with no engine change.
NARRATOR_KIND=template

# Insight-detector tuning
CORRELATION_THRESHOLD=0.5
OUTLIER_IQR_FACTOR=1.5
DOMINANT_CATEGORY_THRESHOLD=0.4
MISSINGNESS_THRESHOLD=0.2
MAX_INSIGHTS=12

# Redis deck cache TTL (seconds). Fail-open: a Redis outage never breaks generation.
DECK_CACHE_TTL_SECONDS=3600

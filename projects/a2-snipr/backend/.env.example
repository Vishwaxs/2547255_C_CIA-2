# ---- Snipr backend environment ----
# Copy to .env and adjust. Never commit the real .env.

# HTTP
PORT=4000
# Base URL used when returning the full short link (no trailing slash)
PUBLIC_BASE_URL=http://localhost:4000

# PostgreSQL (Prisma reads DATABASE_URL)
DATABASE_URL=postgresql://snipr:snipr@localhost:5432/snipr?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Cache-aside TTL for resolved links, in seconds
LINK_CACHE_TTL_SECONDS=3600

# Click-buffer flush interval, in milliseconds
FLUSH_INTERVAL_MS=5000

# Rate limits (fixed-window). Window in seconds, max requests per window per IP.
RATE_LIMIT_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_CREATE_MAX=20
RATE_LIMIT_REDIRECT_WINDOW_SECONDS=60
RATE_LIMIT_REDIRECT_MAX=600

# CORS origin for the frontend dashboard
CORS_ORIGIN=http://localhost:5173

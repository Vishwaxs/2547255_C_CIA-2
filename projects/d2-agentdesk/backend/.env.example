PORT=4008
PUBLIC_BASE_URL=http://localhost:4008
DATABASE_URL=postgresql://agentdesk:agentdesk@localhost:5440/agentdesk?schema=public
REDIS_URL=redis://localhost:6387
CORS_ORIGIN=http://localhost:5181
# Which Planner drives the agent loop. rule_based is deterministic and offline;
# llm is the drop-in seam and needs ANTHROPIC_API_KEY + egress (absent in this build).
PLANNER_KIND=rule_based
# Hard ceiling on Thought->Action->Observation cycles before the agent force-escalates.
AGENT_MAX_STEPS=6
# TTL for the fail-open Redis cache of the knowledge base (0 disables caching).
KB_CACHE_TTL_SECONDS=120

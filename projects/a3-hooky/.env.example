# ---- A3 Hooky backend environment ----
# Copy to backend/.env and adjust. Never commit the real .env.

PORT=4006
PUBLIC_BASE_URL=http://localhost:4006
DATABASE_URL=postgresql://hooky:hooky@localhost:5438/hooky?schema=public
REDIS_URL=redis://localhost:6385
CORS_ORIGIN=http://localhost:5179

# Delivery engine
START_WORKER=true
DISPATCH_INTERVAL_MS=1000
RETRY_BASE_MS=2000
RETRY_CAP_MS=300000
DEFAULT_MAX_ATTEMPTS=5
TRANSPORT=sink
IDEMPOTENCY_TTL_SECONDS=86400

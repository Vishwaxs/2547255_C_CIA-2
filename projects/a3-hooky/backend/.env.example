PORT=4006
PUBLIC_BASE_URL=http://localhost:4006
DATABASE_URL=postgresql://hooky:hooky@localhost:5438/hooky?schema=public
REDIS_URL=redis://localhost:6385
CORS_ORIGIN=http://localhost:5179

# Delivery engine
START_WORKER=true            # run the dispatcher loop in-process (false in tests)
DISPATCH_INTERVAL_MS=1000    # how often the dispatcher processes due deliveries
RETRY_BASE_MS=2000           # exponential backoff base (base * 2^(attempt-1))
RETRY_CAP_MS=300000          # backoff cap
DEFAULT_MAX_ATTEMPTS=5       # attempts before a delivery is dead-lettered
TRANSPORT=sink               # sink (offline, deterministic) | http (real fetch)
IDEMPOTENCY_TTL_SECONDS=86400

# ---- D1 RAG backend environment ----
# Copy to backend/.env and adjust. Never commit the real .env.

# HTTP
PORT=4003
PUBLIC_BASE_URL=http://localhost:4003

# PostgreSQL (Prisma reads DATABASE_URL)
# Port 5435 when using the dev docker-compose.yml (avoids clash with Snipr/QAForge/SyncBridge)
DATABASE_URL=postgresql://d1rag:d1rag@localhost:5435/d1rag?schema=public

# Redis — answer cache only (fail-open; a Redis outage never breaks a query)
REDIS_URL=redis://localhost:6382

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:5176

# RAG engine implementations. openai/claude are stubs (no keys in this air-gapped build):
# the Embedder/Generator interfaces exist so a real model drops in with no engine change.
EMBEDDER_KIND=tfidf
GENERATOR_KIND=extractive
EMBEDDING_DIM=256

# Retrieval defaults (a request may override topK / threshold)
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.05

# Redis answer-cache TTL (seconds)
ANSWER_CACHE_TTL_SECONDS=3600

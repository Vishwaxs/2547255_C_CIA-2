PORT=4003
PUBLIC_BASE_URL=http://localhost:4003
DATABASE_URL=postgresql://d1rag:d1rag@localhost:5435/d1rag?schema=public
REDIS_URL=redis://localhost:6382
CORS_ORIGIN=http://localhost:5176

# RAG engine — which embedder / generator implementation to use.
# tfidf|hashing|openai  ·  extractive|claude   (openai/claude are stubs: no keys in this build)
EMBEDDER_KIND=tfidf
GENERATOR_KIND=extractive
# Hashing embedder vector size (tfidf sizes itself to the corpus vocabulary).
EMBEDDING_DIM=256
# Retrieval defaults (overridable per request).
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.05
# Redis answer-cache TTL (seconds). Cache is fail-open: a Redis outage never breaks a query.
ANSWER_CACHE_TTL_SECONDS=3600

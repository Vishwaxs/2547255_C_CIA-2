# ---- QAForge backend environment ----
# Copy to .env and adjust. Never commit the real .env.

# HTTP
PORT=4001
PUBLIC_BASE_URL=http://localhost:4001

# PostgreSQL (Prisma reads DATABASE_URL)
# Port 5433 when using the dev docker-compose.yml (avoids clash with Snipr on 5432)
DATABASE_URL=postgresql://qaforge:qaforge@localhost:5433/qaforge?schema=public

# Redis
# Port 6380 when using the dev docker-compose.yml (avoids clash with Snipr on 6379)
REDIS_URL=redis://localhost:6380

# CORS origin for the frontend dashboard
CORS_ORIGIN=http://localhost:5174

# Max concurrent HTTP requests the run engine fires at once (p-limit)
RUN_CONCURRENCY=5

# Default HTTP timeout per test case (ms)
RUN_TIMEOUT_MS=10000

# Flakiness window: number of recent runs to consider when computing the score
FLAKINESS_WINDOW=30

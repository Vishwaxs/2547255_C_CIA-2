# ---- SyncBridge backend environment ----
# Copy to .env and adjust. Never commit the real .env.

# HTTP
PORT=4002
PUBLIC_BASE_URL=http://localhost:4002

# PostgreSQL (Prisma reads DATABASE_URL)
# Port 5434 when using the dev docker-compose.yml (avoids clash with Snipr 5432 / QAForge 5433)
DATABASE_URL=postgresql://syncbridge:syncbridge@localhost:5434/syncbridge?schema=public

# Redis — required for the BullMQ sync scheduler/worker
# Port 6381 when using the dev docker-compose.yml (avoids clash with Snipr 6379 / QAForge 6380)
REDIS_URL=redis://localhost:6381

# CORS origin for the frontend config UI
CORS_ORIGIN=http://localhost:5175

# Max concurrent record upserts the sync engine performs at once (p-limit)
SYNC_CONCURRENCY=5

# Whether to start the BullMQ worker in-process (set to false in tests)
START_WORKER=true
